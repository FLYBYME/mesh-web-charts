{
    "name": "@flybyme/mesh-web-charts",
    "version": "0.1.1",
    "description": "An advanced, mobile-ready charting package for mesh-web sites, drawn with d3.",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./charts.css": "./dist/charts.css"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json && cp src/charts.css dist/charts.css",
        "prepare": "npm run build",
        "typecheck": "tsc -p tsconfig.check.json --noEmit",
        "test:browser": "vitest run --config vitest.browser.config.ts",
        "//test": "Typecheck first: vitest transpiles without checking types, so a suite can be green while the compiler is not.",
        "test": "npm run typecheck && npm run test:browser",
        "//example:gallery": "The interactive charts gallery on http://localhost:5192, built on this package's source.",
        "example:gallery": "vite --config examples/gallery/vite.config.ts"
    },
    "license": "UNLICENSED",
    "peerDependencies": {
        "@flybyme/mesh-web": ">=0.21.0"
    },
    "dependencies": {
        "d3-array": "^3.2.4",
        "d3-axis": "^3.0.0",
        "d3-color": "^3.1.0",
        "d3-format": "^3.1.0",
        "d3-interpolate": "^3.0.1",
        "d3-scale": "^4.0.2",
        "d3-selection": "^3.0.0",
        "d3-shape": "^3.2.0",
        "d3-time": "^3.1.0",
        "d3-time-format": "^4.1.0",
        "d3-zoom": "^3.0.0"
    },
    "devDependencies": {
        "@flybyme/mesh-web": "^0.21.19",
        "@types/d3-array": "^3.2.1",
        "@types/d3-axis": "^3.0.6",
        "@types/d3-color": "^3.1.3",
        "@types/d3-format": "^3.0.4",
        "@types/d3-interpolate": "^3.0.4",
        "@types/d3-scale": "^4.0.8",
        "@types/d3-selection": "^3.0.11",
        "@types/d3-shape": "^3.1.7",
        "@types/d3-time": "^3.0.4",
        "@types/d3-time-format": "^4.0.3",
        "@types/d3-zoom": "^3.0.8",
        "@types/node": "^26.4.1",
        "@vitest/browser": "^2.1.9",
        "axe-core": "^4.13.0",
        "playwright": "^1.62.1",
        "typescript": "^5.9.3",
        "vite": "^5.4.14",
        "vitest": "^2.1.9",
        "zod": "^3.25.76"
    },
    "publishConfig": {
        "registry": "https://registry.surfdns.net/"
    }
}
